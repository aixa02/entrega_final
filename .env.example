# ---------- LLM (Gemini) ----------
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.5-flash
# Pedidos por minuto al LLM (plan gratuito de Gemini: 5)
LLM_RPM=4

# ---------- RAG (Pinecone + embeddings locales) ----------
PINECONE_API_KEY=
PINECONE_INDEX=fastapi-docs-rag
PINECONE_NAMESPACE=fastapi-docs
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379
# 1 con el plan gratuito de Gemini (ver README)
WORKERS=1

# ---------- Observabilidad (LangSmith) ----------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=orquestador-final
