# ---------- LLM (Gemini) ----------
GOOGLE_API_KEY=
# Flash Lite: el plan gratuito permite 15 pedidos/min y bastante más cuota diaria que Flash (ver README)
LLM_MODEL=gemini-3.1-flash-lite
# Pedidos por minuto al LLM (con margen sobre el límite del modelo)
LLM_RPM=12

# ---------- RAG (Pinecone + embeddings locales) ----------
PINECONE_API_KEY=
PINECONE_INDEX=fastapi-docs-rag
PINECONE_NAMESPACE=fastapi-docs
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ---------- Redis ----------
# localhost para correr la API a mano; docker compose lo reemplaza por redis://redis:6379
REDIS_URL=redis://localhost:6379
# 1 con el plan gratuito de Gemini (ver README)
WORKERS=1

# ---------- Diagnóstico ----------
# true: avisa si algo bloquea el event loop más de 100 ms
ASYNC_DEBUG=false

# ---------- Observabilidad (LangSmith) ----------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=orquestador-final
